<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Kenya Time</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --red:    #bb0000;
      --green:  #006600;
      --black:  #111111;
      --white:  #f5f0e8;
      --gold:   #c8960c;
    }
    body {
      background-color: var(--black);
      color: var(--white);
      font-family: 'Space Mono', monospace;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }
    .stripes {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      opacity: 0.07;
      pointer-events: none;
      z-index: 0;
    }
    .stripe { flex: 1; }
    .stripe.black { background: #ffffff; }
    .stripe.red   { background: var(--red); }
    .stripe.green { background: var(--green); }
    .stripe.white { background: #ffffff; height: 6px; flex: none; }
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      opacity: 0.35;
      pointer-events: none;
      z-index: 0;
    }
    .card {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 3rem 2.5rem;
      border: 1px solid rgba(200,150,12,0.3);
      background: rgba(17,17,17,0.82);
      backdrop-filter: blur(8px);
      border-radius: 4px;
      max-width: 360px;
      width: 90vw;
      box-shadow: 0 0 80px rgba(200,150,12,0.08), 0 2px 40px rgba(0,0,0,0.7);
      animation: fadeIn 1s ease both;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .flag-icon {
      font-size: 2.8rem;
      margin-bottom: 0.6rem;
      animation: wave 3s ease-in-out infinite;
      display: inline-block;
    }
    @keyframes wave {
      0%, 100% { transform: rotate(-4deg); }
      50%       { transform: rotate(4deg); }
    }
    .label {
      font-family: 'Playfair Display', serif;
      font-size: 0.85rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1.8rem;
    }
    .time {
      font-family: 'Space Mono', monospace;
      font-size: clamp(3rem, 16vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--white);
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    .ampm {
      font-size: 1.1rem;
      color: var(--gold);
      letter-spacing: 0.2em;
      margin-bottom: 1.6rem;
    }
    .date {
      font-size: 0.78rem;
      color: rgba(245,240,232,0.55);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 2rem;
    }
    .divider {
      width: 40px;
      height: 2px;
      background: linear-gradient(90deg, var(--red), var(--green));
      margin: 0 auto 1.8rem;
      border-radius: 2px;
    }
    .timezone-note {
      font-size: 0.7rem;
      color: rgba(245,240,232,0.35);
      letter-spacing: 0.1em;
    }
    .dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      background: var(--green);
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
      animation: pulse 1s steps(1) infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }
  </style>
</head>
<body>
  <div class="stripes">
    <div class="stripe black"></div>
    <div class="stripe white"></div>
    <div class="stripe red"></div>
    <div class="stripe white"></div>
    <div class="stripe green"></div>
  </div>
  <div class="card">
    <div class="flag-icon">🇰🇪</div>
    <div class="label">Nairobi &nbsp;·&nbsp; Kenya</div>
    <div class="time" id="time">--:--:--</div>
    <div class="ampm" id="ampm">--</div>
    <div class="date" id="date">Loading...</div>
    <div class="divider"></div>
    <div class="timezone-note"><span class="dot"></span>East Africa Time &nbsp;UTC+3</div>
  </div>
  <script>
    function updateTime() {
      const now = new Date();
      const kenya = new Date(now.toLocaleString('en-US', { timeZone: 'Africa/Nairobi' }));
      let h = kenya.getHours();
      const m = String(kenya.getMinutes()).padStart(2, '0');
      const s = String(kenya.getSeconds()).padStart(2, '0');
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      const hStr = String(h).padStart(2, '0');
      document.getElementById('time').textContent = `${hStr}:${m}:${s}`;
      document.getElementById('ampm').textContent = ampm;
      const days   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      document.getElementById('date').textContent = `${days[kenya.getDay()]}, ${months[kenya.getMonth()]} ${kenya.getDate()}, ${kenya.getFullYear()}`;
    }
    updateTime();
    setInterval(updateTime, 1000);
  </script>
</body>
</html>
